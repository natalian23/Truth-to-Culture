# Substack feed used to fill the Reading Room (build time, revalidated daily).
SUBSTACK_FEED_URL=https://connected565.substack.com/feed

# Optional: Formspree form id. When set, the contact form POSTs to Formspree.
# When unset, the form falls back to opening the visitor's mail client.
NEXT_PUBLIC_FORMSPREE_ID=

# --- Season builder (POST /api/season, used by the app) ---
# Server-side only. Set in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Optional shared token the app must send as x-ttc-token. Leave blank to disable.
SEASON_API_TOKEN=
